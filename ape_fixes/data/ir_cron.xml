<!-- data/ir_cron_move_website_description.xml -->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_move_website_description_to_tab" model="ir.cron">
            <field name="name">Move Website Description to Product Tab</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model.move_website_description()</field>
        </record>

        <record id="ir_cron_update_product_descriptions" model="ir.cron">
            <field name="name">Update Product Descriptions from Excel</field>
            <field name="model_id" ref="ape_fixes.model_product_description_updater"/>
            <field name="state">code</field>
            <field name="code">model.update_product_descriptions()</field>
        </record>
    </data>
</odoo>
