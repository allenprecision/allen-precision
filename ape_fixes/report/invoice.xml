<odoo>
    <data>
        <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">
        <xpath expr = "//t[@t-set='information_block']" position='after'>
            <div>
            <p>
                <span> Customer #:</span>
                <strong><t t-esc="o.customer_number"/></strong>
            </p>
            </div>
        </xpath>

        <xpath expr="//div[@class='mb-3'][p[@name='payment_communication']]" position="replace"/>

        </template>
        <template id="custom_report_picking" inherit_id="stock.report_picking">
            <xpath expr="//div[@class='row justify-content-end mb16']" position="replace"/>
        </template>
    </data>
</odoo>