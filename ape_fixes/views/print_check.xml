<odoo>
    <template id="l10n_us_check_printing_inherit" inherit_id="l10n_us_check_printing.ckus_check">
        <xpath expr="//div[hasclass('ckus_payee_addr')]" position="attributes">
            <attribute name="class">ckus_payee_addr mt-4</attribute>
        </xpath>
        <xpath expr="//div[hasclass('ckus_memo')]" position="attributes">
            <attribute name="class">ckus_memo d-none</attribute>
        </xpath>
        <xpath expr="//div[hasclass('ckus_payee_name')]" position="attributes">
            <attribute name="class">ckus_payee_name d-none</attribute>
        </xpath>
        <xpath expr="//div[hasclass('ckus_amount_in_word')]" position="attributes">
            <attribute name="class">ckus_amount_in_word ml-4</attribute>
        </xpath>
    </template>

    <template id="ckus_stub_custom" inherit_id="l10n_us_check_printing.ckus_stub" priority="20">Add commentMore actions
        <!-- Replace the entire summary_line <div> -->
        <xpath expr="//div[@class='row summary_line']" position="replace">
            <div class="row summary_line">
            <div class="col-4">
                <span t-out="page['partner_name']"/>
            </div>
            <div class="col-2">
                <span t-out="page['date']"/>
            </div>
            <div class="col-3">
                <span t-if="page['sequence_number']" t-out="page['sequence_number']"/>
            </div>
        </div>
        </xpath>
    </template>

    <template id="ckus_check_custom" inherit_id="l10n_us_check_printing.ckus_check" priority="20">
        <!-- Target the sequence_number div and replace it with a hidden version -->
        <xpath expr="///div[@class='sequence_number']" position="replace"/>Add commentMore actions
    </template>
</odoo> 
