<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Paper format for stock report -->
    <record id="paperformat_custom_report" model="report.paperformat">
        <field name="name">Stock Product Report A4</field>
        <field name="default" eval="False" />
        <field name="format">custom</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">50</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">45</field>
        <field name="page_height">297</field>
        <field name="page_width">210</field>
    </record>

    <!-- Report Action -->
    <record id="sh_stock_product_report_action" model="ir.actions.report">
        <field name="name">Stock Product Report</field>
        <field name="model">report.sh_all_in_one_stock_report.sh_stock_report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="sh_all_in_one_stock_report.paperformat_custom_report" />
        <field name="report_name">sh_all_in_one_stock_report.sh_stock_report</field>
        <field name="print_report_name">'stock Product Report'</field>
    </record>
</odoo>