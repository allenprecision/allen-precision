<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="sh_advance_inventory_report">
		<t t-call="web.html_container">
			<t t-call="web.external_layout">
				<div class="page">
					<div class="oe_structure" />
					<div class="d-flex w-100 space-between row" >
						<h5 class="col-4">
							<b>From Date: </b>
							<t t-esc="sh_from_date"/>
						</h5>
						<h5 class="col-4"></h5>
						<h5 class="col-4">
							<b>To Date: </b>
							<t t-esc="sh_to_date"/>
						</h5>
					</div>
					<div class="row">
						<div class="col-md-12 mx-auto">
							<div class="text-center">
								<h4>
									<b>FSN Report</b>
								</h4>
							</div>
						</div>
					</div>
					<br />
					<div class="d-inline-flex" style="width:100%">
						<div  style="border-style: solid; border-width: 1px 0px 0px 1px;padding-left:3px; font-weight: bold;width:5%;text-align:center;">Sr.</div>
						<div  style="border-style: solid; border-width: 1px 0px 0px 1px;padding-left:3px; font-weight: bold;width:35%;text-align:center;">Product</div>
						<div  style="border-style: solid; border-width: 1px 0px 0px 1px;padding-left:3px; font-weight: bold;width:10%;text-align:center;">Opening Stock</div>
						<div  style="border-style: solid; border-width: 1px 0px 0px 1px;padding-left:3px; font-weight: bold;width:10%;text-align:center;">Closing Stock</div>
						<div  style="border-style: solid; border-width: 1px 0px 0px 1px;padding-left:3px; font-weight: bold;width:10%;text-align:center;">Average Stock</div>
						<div  style="border-style: solid; border-width: 1px 0px 0px 1px;padding-left:3px; font-weight: bold;width:10%;text-align:center;">Sales</div>
						<div  style="border-style: solid; border-width: 1px 1px 0px 1px;padding-left:3px; font-weight: bold;width:10%;text-align:center;">Turn Over Ratio</div>
						<div  style="border-style: solid; border-width: 1px 1px 0px 1px;padding-left:3px; font-weight: bold;width:10%;text-align:center;">FSN Analysis</div>
					</div>
					<t t-set="count" t-value="0" />
					<t t-foreach="fsn_stock_list" t-as="fsn">
						<t t-set="count" t-value="count + 1" />
						<div class="d-inline-flex"  style="width:100%">
							<t t-if="fsn.get('fsn')=='F'">
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:5%;text-align:right;">
									<span  style="padding-right:2px;color:#2e7d32;" t-esc="count" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:35%;">
									<span  style="color:#2e7d32;" t-esc="fsn.get('product')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span   style="padding-right:2px;color:#2e7d32;" t-esc="fsn.get('open_stock')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span  style="padding-right:2px;color:#2e7d32;" t-esc="fsn.get('close_stock')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span  style="padding-right:2px;color:#2e7d32;" t-esc="fsn.get('avg_stock')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span  style="padding-right:2px;color:#2e7d32;" t-esc="fsn.get('sale_qty')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 1px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span  style="padding-right:2px;color:#2e7d32;" t-esc="fsn.get('turn_over_ratio')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 1px 0px 1px;padding-left:3px;width:10%;text-align:center;">
									<span  style="color:#2e7d32;" t-esc="fsn.get('fsn')" />
								</div>
							</t>
							<t t-if="fsn.get('fsn')=='S'">
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:5%;text-align:right;">
									<span  style="padding-right:2px;color:#ff8f00;" t-esc="count" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:35%;">
									<span  style="color:#ff8f00;" t-esc="fsn.get('product')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span  style="padding-right:2px;color:#ff8f00;" t-esc="fsn.get('open_stock')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span  style="padding-right:2px;color:#ff8f00;" t-esc="fsn.get('close_stock')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span  style="padding-right:2px;color:#ff8f00;" t-esc="fsn.get('avg_stock')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span  style="padding-right:2px;color:#ff8f00;" t-esc="fsn.get('sale_qty')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 1px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span  style="padding-right:2px;color:#ff8f00;" t-esc="fsn.get('turn_over_ratio')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 1px 0px 1px;padding-left:3px;width:10%;text-align:center;">
									<span  style="color:#ff8f00;"  t-esc="fsn.get('fsn')" />
								</div>
							</t>
							<t t-if="fsn.get('fsn')=='N'">
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:5%;text-align:right;">
									<span  style="padding-right:2px;color:#616161;" t-esc="count" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:35%;">
									<span  style="color:#616161;" t-esc="fsn.get('product')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span  style="padding-right:2px;color:#616161;" t-esc="fsn.get('open_stock')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span  style="padding-right:2px;color:#616161;" t-esc="fsn.get('close_stock')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span  style="padding-right:2px;color:#616161;" t-esc="fsn.get('avg_stock')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 0px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span  style="padding-right:2px;color:#616161;" t-esc="fsn.get('sale_qty')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 1px 0px 1px;padding-left:3px;width:10%;text-align:right;">
									<span  style="padding-right:2px;color:#616161;" t-esc="fsn.get('turn_over_ratio')" />
								</div>
								<div  style="border-style: solid; border-width: 0px 1px 0px 1px;padding-left:3px;width:10%;text-align:center;">
									<span  style="color:#616161;" t-esc="fsn.get('fsn')" />
								</div>
							</t>
						</div>
					</t>
				</div>
			</t>
		</t>
	</template>
	<record id="paperformat_stock_fsn_report_indent" model="report.paperformat">
		<field name="name">Stock FSN Indent</field>
		<field name="default" eval="False" />
		<field name="format">custom</field>
		<field name="orientation">Portrait</field>
		<field name="margin_top">50</field>
		<field name="margin_bottom">15</field>
		<field name="margin_left">7</field>
		<field name="margin_right">7</field>
		<field name="header_line" eval="False" />
		<field name="header_spacing">45</field>
		<field name="page_height">297</field>
		<field name="page_width">210</field>
	</record>
	<record id="sh_fsn_stock_report_action" model="ir.actions.report">
		<field name="name">FSN Report</field>
		<field name="model">report.sh_all_in_one_stock_report.sh_advance_inventory_report</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">sh_all_in_one_stock_report.sh_advance_inventory_report</field>
		<field name="print_report_name">'FSN Report'</field>
		<field name="paperformat_id" ref="sh_all_in_one_stock_report.paperformat_stock_fsn_report_indent" />
	</record>
</odoo>