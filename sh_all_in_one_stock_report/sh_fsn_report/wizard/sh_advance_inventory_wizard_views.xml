<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="sh_advance_inventory_report_wizard_view" model="ir.ui.view">
		<field name="name">FSN Advance Inventory Report</field>
		<field name="model">sh.advance.inventory.report.wizard</field>
		<field name="arch" type="xml">
			<form string="FSN Advance Inventory Report">
				<group>
					<group>
						<field name="sh_from_date"/>
					</group>
					<group>
						<field name="sh_to_date"/>
					</group>
				</group>
				<group>
					<field name="sh_product_ids" widget="many2many_tags"/>
				</group>
				<footer>
					<button name="sh_print_stock_report" string="Print Pdf Report" class="oe_highlight" type="object"/>
					<button name="get_xls_report" string="Print Xls Report" class="oe_highlight" type="object"/>
					<button string="Cancel" class="btn-default" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>
	<record id="sh_advance_inventory_report_wizard_action" model="ir.actions.act_window">
		<field name="name">FSN Advance Inventory Report</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">sh.advance.inventory.report.wizard</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
	</record>
	<menuitem
            name="FSN Advance Inventory Report"
            parent="stock.menu_warehouse_report"
            action="sh_advance_inventory_report_wizard_action"
            id="sh_advance_inventory_report_id"
			groups="sh_all_in_one_stock_report.sh_group_fsn_report"
            sequence="5"/>
</odoo>