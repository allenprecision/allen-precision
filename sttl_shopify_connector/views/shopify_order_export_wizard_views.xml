<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_order_export_wizard_form" model="ir.ui.view">
        <field name="name">shopify.order.export.wizard.form</field>
        <field name="model">shopify.order.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Orders — Altera / Matrixify Format">
                <group invisible="state == 'done'">
                    <field name="only_unexported"/>
                    <field name="offset" string="Skip first N orders (batch offset)"/>
                </group>
                <group invisible="state != 'done'">
                    <field name="record_count" string="Orders in this file"/>
                    <field name="file_name" invisible="1"/>
                    <field name="file_data" filename="file_name" widget="binary" string="Download Excel File"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generate Excel" type="object"
                            class="oe_highlight" invisible="state == 'done'"/>
                    <button name="action_reset" string="Generate Another Batch" type="object"
                            invisible="state != 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shopify_order_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Orders to Shopify (Altera Format)</field>
        <field name="res_model">shopify.order.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_shopify_order_export"
              name="Export Orders (Altera/Matrixify)"
              parent="menu_shopify_root"
              action="action_shopify_order_export_wizard"
              sequence="20"/>
</odoo>
