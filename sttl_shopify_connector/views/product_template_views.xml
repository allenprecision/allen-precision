<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_shopify" model="ir.ui.view">
        <field name="name">product.template.form.shopify</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Shopify" name="shopify">
                    <group>
                        <group>
                            <field name="shopify_instance_id" options="{'no_create': True}"/>
                            <field name="shopify_product_id" readonly="1"/>
                            <field name="is_exported_to_shopify" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="action_shopify_export_bulk" model="ir.actions.server">
        <field name="name">Export to Shopify</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_export_to_shopify()
        </field>
    </record>
</odoo>
