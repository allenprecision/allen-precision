<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_shopify" model="ir.ui.view">
        <field name="name">res.partner.form.shopify</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Shopify" name="shopify">
                    <group>
                        <group>
                            <field name="shopify_instance_id" options="{'no_create': True}"/>
                            <field name="shopify_customer_id" readonly="1" invisible="is_company"/>
                            <!-- <field name="shopify_company_id" readonly="1" invisible="not is_company"/> -->
                            <field name="is_exported_to_shopify" readonly="1"/>
                        </group>
                    </group>
                    <button name="action_export_to_shopify" string="Export to Shopify" type="object" class="oe_highlight" invisible="not shopify_instance_id"/>
                </page>
            </xpath>
        </field>
    </record>
    <record id="action_shopify_export_customer_bulk" model="ir.actions.server">
        <field name="name">Export to Shopify</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_export_to_shopify()
        </field>
    </record>
</odoo>
