<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_last_order_date_tree_view" model="ir.ui.view">
        <field name="name">product.last.order.date.tree.view</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="product_tmpl_id" position="after">
                <field name="product_last_so_date" widget="remaining_days" optional="show"/>
                <field name="product_last_po_date" widget="remaining_days" optional="show"/>
                <field name="last_so_id" optional="hide"/>
                <field name="last_po_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="product_last_order_date_form_view" model="ir.ui.view">
        <field name="name">product.last.order.date.form.view</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="uom_po_id" position="after">
                <field name="product_last_so_date"/>
                <field name="product_last_po_date"/>
                <field name="last_so_id" readonly="1"/>
                <field name="last_po_id" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>